{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "selezioni-online": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "src/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "/assets/"
              },
              "src/favicon.ico",
              {
                "glob": "**/*",
                "input": "node_modules/bootstrap-italia/",
                "output": "/bootstrap-italia/"
              },
              {
                "glob": "**/*",
                "input": "node_modules/design-angular-kit/assets/i18n",
                "output": "/bootstrap-italia/i18n/"
              },
              {
                "glob": "sprites.svg",
                "input": "node_modules/bootstrap-italia/dist/svg",
                "output": "/assets/bootstrap-italia/svg"
              }
            ],
            "styles": [
              "node_modules/font-awesome/css/font-awesome.min.css",
              "node_modules/quill/dist/quill.snow.css",
              "src/styles.scss"
            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/select2/dist/js/select2.full.js"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "node_modules"
              ],
              "sass": {
                "silenceDeprecations": [
                  "import",
                  "global-builtin",
                  "color-functions",
                  "abs-percent",
                  "mixed-decls"
                ]
              }
            },
            "allowedCommonJsDependencies": [
              "json2typescript",
              "file-saver",
              "quill-delta",
              "lodash.clonedeep",
              "lodash.isequal",
              "eventemitter3"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3mb",
                  "maximumError": "6mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kb"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "selezioni-online:build:production"
            },
            "development": {
              "buildTarget": "selezioni-online:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "selezioni-online-e2e": {
      "root": "",
      "sourceRoot": "e2e",
      "projectType": "application",
      "architect": {
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "./protractor.conf.js",
            "devServerTarget": "selezioni-online:serve"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "app",
      "style": "scss"
    },
    "@schematics/angular:directive": {
      "prefix": "app"
    }
  },
  "cli": {
    "schematicCollections": [
      "@nativescript/schematics"
    ],
    "analytics": false
  }
}
